//-------------------------------------------------
// SINI Activities
//-------------------------------------------------

//-------------------------------------------------
// CSHDL Definitions
//------------------------------------------------- 
//Init
CRHDL DEFINE INTERNAL ACTIVITY  GEAR_vInit    IS OF TYPE INIT  AND DONE AT INIT  OF SRES_CANPassive SEQUENCE 10 RUNTIME IS 2000;

//Deinit
CRHDL DEFINE INTERNAL ACTIVITY  GEAR_vDeInit  IS OF TYPE DEINIT  AND DONE AT DEINIT  OF SRES_CANPassive  SEQUENCE 10 RUNTIME IS 2000;

//-------------------------------------------------
// Request Definitions
//-------------------------------------------------

//-------------------------------------------------
// Timer Definitions
//-------------------------------------------------

//-------------------------------------------------
// Event Definitions
//-------------------------------------------------

//-------------------------------------------------
// Event Usages
//-------------------------------------------------

//-------------------------------------------------
// Cyclic Activities
//-------------------------------------------------
CAM DEFINE ACTIVITY GEAR_vMain IS OF TYPE CYCLIC EXECUTED IN Every25ms
        NEEDS RESOURCE STATES:{
          INIT OF SRES_CANPassive;
        }
        SEQUENCE  3 RUNTIME IS 1;
      
//-------------------------------------------------
// DPOOL
//-------------------------------------------------
DPOOL DEFINE STRUCT GEAR_tstGearData
   ELEMENT  uint8  GEAR_u8GearPosi;
   
DPOOL DEFINE DATA GEAR_stGearData TYPE GEAR_tstGearData DEFAULTVALUE "{0}"; 

DPOOL USE DATA GEAR_stGearData;

DPOOL DEFINE STRUCT GEAR_tstShiftSymbolData
   ELEMENT  uint8  GEAR_u8ShiftSymbolPosi;

DPOOL DEFINE DATA GEAR_stShiftSymbolData TYPE GEAR_tstShiftSymbolData DEFAULTVALUE "{0}"; 

DPOOL USE DATA GEAR_stShiftSymbolData;
/***********************************************************************
 *                 END OF FILE
 ***********************************************************************/
